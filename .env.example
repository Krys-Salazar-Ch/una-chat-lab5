# Copie este archivo como .env y complete los valores. NUNCA suba .env a GitHub.

# ---------- Grafana Cloud (partes 2 y 3, solo en local) ----------
# Grafana Cloud → su stack → Connections → OpenTelemetry (OTLP)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
# Formato exacto, sin comillas:  Authorization=Basic%20<base64 de instanceId:token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=una-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,deployment.environment.name=local

# Fallo controlado: el mensaje "/fallo" provoca un error (solo local)
ENABLE_FAULT_INJECTION=true

# Token opcional para POST /api/mensajes (Artillery lo envía como Bearer)
CHAT_API_TOKEN=

# ---------- Sentry (parte 1) ----------
# En Render se configuran en Environment, no aquí.
SENTRY_DSN=
SENTRY_TEST_ROUTE=

# ---------- Auth0 + Supabase Vault (laboratorio 8) ----------
# Si AUTH0_DOMAIN y AUTH0_CLIENT_ID quedan vacíos, el chat queda abierto (pruebas).
# Dominio sin https://, por ejemplo dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Local: http://localhost:3000 · Render: https://TU-SERVICIO.onrender.com (sin barra final)
APP_BASE_URL=http://localhost:3000

# URI de Postgres del rol una_chat_backend. TLS obligatorio.
# Host directo (IPv6):   postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler (IPv4): postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# NO configure AUTH0_CLIENT_SECRET. El backend lee una_chat_auth0_client_secret
# desde Supabase Vault al arrancar (certificado: server/supabase-root-2021-ca.pem).
